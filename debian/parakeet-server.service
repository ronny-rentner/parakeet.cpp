[Unit]
Description=Parakeet speech recognition server

[Service]
User=parakeet
StateDirectory=parakeet
# GPU render nodes for PARAKEET_DEVICE=Vulkan0.
SupplementaryGroups=render video
Environment=PARAKEET_DEVICE=Vulkan0
EnvironmentFile=-/etc/default/parakeet-server
ExecStart=/usr/bin/parakeet-server --model ${PARAKEET_MODEL} --threads 4 $PARAKEET_ARGS
CPUAffinity=0-7
Nice=-10
LimitNICE=-10
CPUWeight=300
IOWeight=300
Restart=on-failure

[Install]
WantedBy=multi-user.target
